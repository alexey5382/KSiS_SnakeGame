<Window x:Class="Snake.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake Multiplayer" 
        Width="9600" Height="600" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded"
        Background="{DynamicResource AppBackground}">
        <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#2D2D30"/>
        <SolidColorBrush x:Key="OverlayBackground" Color="#D9000000"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ListBackground" Color="#222222"/>
        <SolidColorBrush x:Key="CanvasBackground" Color="Black"/>

        <SolidColorBrush x:Key="TextPrimary" Color="White"/>
        <SolidColorBrush x:Key="TextSecondary" Color="LightGray"/>
        <SolidColorBrush x:Key="TextHighlight" Color="Yellow"/>
        <SolidColorBrush x:Key="TextSuccess" Color="LimeGreen"/>
        <SolidColorBrush x:Key="TextError" Color="Tomato"/>
        <SolidColorBrush x:Key="TextWarning" Color = "Red"/>
        <SolidColorBrush x:Key="TextInfo" Color="Cyan"/>

        <SolidColorBrush x:Key="BorderNormal" Color="Gray"/>
        <SolidColorBrush x:Key="BorderDark" Color="#555555"/>
        <SolidColorBrush x:Key="ButtonSecondaryBg" Color="#444444"/>

        <SolidColorBrush x:Key="Snake1Color" Color="DodgerBlue"/>
        <SolidColorBrush x:Key="Snake2Color" Color="Crimson"/>
        <SolidColorBrush x:Key="FoodNormalColor" Color="LimeGreen"/>
        <SolidColorBrush x:Key="FoodGoldColor" Color="Gold"/>
        <SolidColorBrush x:Key="FoodPurpleColor" Color="MediumPurple"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Text="Подключение..." Foreground="{StaticResource TextPrimary}" FontSize="18" Margin="10" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border x:Name="LeaderboardPanel" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Width="250" Height="300" Margin="0,0,20,0" Visibility="Collapsed">
                <StackPanel Margin="15">
                    <TextBlock Text="ТОП-5 ИГРОКОВ" Foreground="{StaticResource TextHighlight}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ListBox x:Name="LeaderboardList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Width="180">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="14" Foreground="{StaticResource TextSuccess}" FontWeight="Bold" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border x:Name="GameBorder" BorderBrush="{StaticResource BorderNormal}" BorderThickness="2">
                    <Canvas x:Name="GameCanvas" Background="{StaticResource CanvasBackground}" ClipToBounds="True"/>
                </Border>

                <Border x:Name="MainMenuPanel" Background="{StaticResource OverlayBackground}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <TextBlock Text="Ваше имя:" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <TextBox x:Name="PlayerNameInput" Width="150" Height="30" FontSize="16" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                            <Button Content="Создать лобби" Width="120" Height="35" FontSize="14" Click="CreateLobbyBtn_Click" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Text="Доступные лобби:" Foreground="{StaticResource TextPrimary}" FontSize="16" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                        <ListBox x:Name="LobbiesList" Width="320" Height="150" Margin="0,0,0,10" Background="{StaticResource ListBackground}" Foreground="{StaticResource TextPrimary}" 
                                 KeyboardNavigation.TabNavigation="Continue" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Padding" Value="5"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="Присоединиться" Width="110" Height="25" Click="JoinLobbyBtn_Click" Tag="{Binding Id}" Cursor="Hand"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="Сменить аккаунт" Width="140" Height="30" FontSize="14" Margin="0,10,0,0" Click="LogoutBtn_Click" Cursor="Hand" Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="HostWaitingPanel" Background="{StaticResource OverlayBackground}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Ожидание второго игрока..." Foreground="{StaticResource TextPrimary}" FontSize="20" Margin="0,0,0,20"/>
                        <Button Content="Отмена" Width="120" Height="35" FontSize="16" Click="LeaveRoomBtn_Click" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border x:Name="RoomLobbyPanel" Background="{StaticResource OverlayBackground}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="StartGameBtn" Content="Начать игру" Width="180" Height="45" FontSize="18" Margin="0,0,0,15" Click="StartGameBtn_Click" Cursor="Hand"/>
                        <Button Content="Покинуть лобби" Width="140" Height="35" FontSize="14" Click="LeaveRoomBtn_Click" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CountdownPanel" Background="{StaticResource OverlayBackground}" Visibility="Collapsed">
                    <TextBlock x:Name="CountdownText" Text="3" Foreground="{StaticResource TextPrimary}" FontSize="120" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border x:Name="AuthPanel" Background="{StaticResource OverlayBackground}" Visibility="Visible">
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Width="400" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Margin="30" VerticalAlignment="Center">
                            <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ" Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                            <TextBlock Text="Логин:" Foreground="{StaticResource TextSecondary}" FontSize="16" Margin="0,0,0,5"/>
                            <TextBox x:Name="LoginInput" FontSize="18" Padding="5" Margin="0,0,0,15"/>
                            <TextBlock Text="Пароль:" Foreground="{StaticResource TextSecondary}" FontSize="16" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PasswordInput" FontSize="18" Padding="5" Margin="0,0,0,30"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Войти" FontSize="16" Height="40" Click="LoginBtn_Click" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="Регистрация" FontSize="16" Height="40" Click="RegisterBtn_Click" Cursor="Hand"/>
                            </Grid>
                            <TextBlock x:Name="AuthMessageText" Foreground="{StaticResource TextWarning}" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,20,10,10">
            <Button x:Name="RestartBtn" Content="Начать заново" Width="140" Height="35" FontSize="14" Margin="0,0,15,0" IsEnabled="False" Click="RestartBtn_Click"/>
            <Button Content="Завершить игру" Width="140" Height="35" FontSize="14" Click="ExitBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>