<Window x:Class="Snake.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake Multiplayer" 
        Width="960" Height="600" MinWidth="800" MinHeight="500"
        Background="{DynamicResource AppBackground}"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#2D2D30"/>
        <SolidColorBrush x:Key="OverlayBackground" Color="#D9000000"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="InputBackground" Color="#333333"/>
        <SolidColorBrush x:Key="CanvasBackground" Color="Black"/>

        <SolidColorBrush x:Key="TextPrimary" Color="White"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="TextHighlight" Color="Yellow"/>
        <SolidColorBrush x:Key="TextWarning" Color="Orange"/>
        <SolidColorBrush x:Key="TextSuccess" Color="LimeGreen"/>
        <SolidColorBrush x:Key="TextError" Color="Tomato"/>
        <SolidColorBrush x:Key="TextInfo" Color="Cyan"/>

        <SolidColorBrush x:Key="BorderDark" Color="#555555"/>
        <SolidColorBrush x:Key="ButtonPrimaryBg" Color="DodgerBlue"/>
        <SolidColorBrush x:Key="ButtonSecondaryBg" Color="#444444"/>
        <SolidColorBrush x:Key="ButtonDangerBg" Color="#8B0000"/>

        <SolidColorBrush x:Key="Snake1Color" Color="DodgerBlue"/>
        <SolidColorBrush x:Key="Snake2Color" Color="Crimson"/>
        <SolidColorBrush x:Key="FoodNormalColor" Color="LimeGreen"/>
        <SolidColorBrush x:Key="FoodGoldColor" Color="Gold"/>
        <SolidColorBrush x:Key="FoodPurpleColor" Color="MediumPurple"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="GlobalStatusText" Grid.Row="0" Text="Инициализация..." Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">

            <Grid x:Name="AuthPanel" Visibility="Visible">
                <Button Content="Выход" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="30" 
                        Background="{StaticResource ButtonDangerBg}" Foreground="{StaticResource TextPrimary}" 
                        BorderThickness="0" Cursor="Hand" Click="ExitBtn_Click"/>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" 
                        Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <StackPanel>
                        <TextBlock Text="Логин" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="LoginInput" FontSize="16" Padding="6" Margin="0,0,0,15" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>

                        <TextBlock Text="Пароль" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordInput" FontSize="16" Padding="6" Margin="0,0,0,25" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Войти" Height="35" FontSize="14" Cursor="Hand" 
                                    Background="{StaticResource ButtonPrimaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Click="LoginBtn_Click"/>
                            <Button Grid.Column="2" Content="Регистрация" Height="35" FontSize="14" Cursor="Hand" 
                                    Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Click="RegisterBtn_Click"/>
                        </Grid>

                        <TextBlock x:Name="AuthMessageText" Foreground="{StaticResource TextError}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="MainMenuPanel" Visibility="Collapsed">
                <Button Content="Выход" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="30" 
                        Background="{StaticResource ButtonDangerBg}" Foreground="{StaticResource TextPrimary}" 
                        BorderThickness="0" Cursor="Hand" Click="LogoutBtn_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">

                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Width="250" Height="350" Margin="0,0,20,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="ТОП-5 ИГРОКОВ" Foreground="{StaticResource TextHighlight}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <ListBox x:Name="LeaderboardList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" Width="180">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="14" Foreground="{StaticResource TextSuccess}" FontWeight="Bold" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Width="550" Height="350" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,20,0">
                                    <TextBlock Text="Имя в игре:" Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,0,0,5"/>
                                    <TextBox x:Name="PlayerNameInput" FontSize="16" Padding="6" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Создать лобби" VerticalAlignment="Bottom" Height="35" Width="150" FontSize="14" Cursor="Hand" 
                                        Background="{StaticResource ButtonPrimaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Click="CreateLobbyBtn_Click"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource InputBackground}" CornerRadius="5" Margin="0,0,20,0" Padding="5">
                                    <Grid>
                                        <TextBlock x:Name="EmptyLobbyText" Text="Свободных лобби нет" Foreground="{StaticResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                        <ListBox x:Name="LobbiesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                        <Button Grid.Column="1" Content="Присоединиться" Width="120" Height="28" Click="JoinLobbyBtn_Click" Tag="{Binding Id}" Cursor="Hand" Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="1" Content="Игра с ботом" Width="150" Height="50" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Cursor="Hand" 
                                        Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextHighlight}" BorderThickness="0" Click="PlayWithBotBtn_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="RoomLobbyPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">

                    <StackPanel Margin="0,0,30,0">
                        <Button Content="Выйти" Width="100" Height="30" Background="{StaticResource ButtonDangerBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="LeaveRoomBtn_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,20"/>
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Width="250" Height="300" Padding="15">
                            <StackPanel>
                                <TextBlock Text="ТОП-5 ИГРОКОВ" Foreground="{StaticResource TextHighlight}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <ListBox x:Name="LobbyLeaderboardList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" Width="180">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Score}" FontSize="14" Foreground="{StaticResource TextSuccess}" FontWeight="Bold" Margin="10,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="StartGameBtn" Content="Играть" Width="200" Height="50" FontSize="18" FontWeight="Bold" Background="{StaticResource ButtonPrimaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="StartGameBtn_Click" Margin="0,0,0,10"/>
                        <Button x:Name="SettingsBtn" Content="Настройки игры" Width="200" Height="35" FontSize="14" Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="OpenSettingsBtn_Click" Margin="0,0,0,20"/>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Width="400" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Название лобби:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="LobbyNameInput" FontSize="16" Padding="5" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Margin="0,0,0,20" LostFocus="LobbyInfo_LostFocus"/>

                                <TextBlock Text="Игрок 1 (Создатель):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LobbyPlayer1Input" Grid.Column="0" FontSize="14" Padding="5" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" LostFocus="LobbyInfo_LostFocus"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Border Width="12" Height="12" Background="{StaticResource Snake1Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake1Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake1Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake1Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake1Color}" Margin="1"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Игрок 2:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LobbyPlayer2Input" Grid.Column="0" FontSize="14" Padding="5" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" LostFocus="LobbyInfo_LostFocus"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Border Width="12" Height="12" Background="{StaticResource Snake2Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake2Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake2Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake2Color}" Margin="1"/>
                                        <Border Width="12" Height="12" Background="{StaticResource Snake2Color}" Margin="1"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="GamePanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">

                    <StackPanel Width="180" Margin="0,0,30,0" VerticalAlignment="Top">
                        <Button Content="Выйти" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{StaticResource ButtonDangerBg}" Foreground="{StaticResource TextPrimary}" 
                                BorderThickness="0" Cursor="Hand" Click="LeaveRoomBtn_Click" Margin="0,0,0,25"/>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ВРЕМЯ" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="GameTimerText" Text="00:00" Foreground="{StaticResource TextHighlight}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="ДЛИНА ЗМЕЕК" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock x:Name="GamePlayer1Name" Text="Игрок 1" Foreground="{StaticResource Snake1Color}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="GamePlayer1Score" Text="3" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock x:Name="GamePlayer2Name" Text="Игрок 2" Foreground="{StaticResource Snake2Color}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="GamePlayer2Score" Text="3" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid>
                        <Border x:Name="GameBorder" BorderBrush="{StaticResource BorderDark}" BorderThickness="2" VerticalAlignment="Center">
                            <Canvas x:Name="GameCanvas" Background="{StaticResource CanvasBackground}" ClipToBounds="True"/>
                        </Border>

                        <Border x:Name="CountdownPanel" Background="#B3000000" Visibility="Collapsed" CornerRadius="2">
                            <TextBlock x:Name="CountdownText" Text="3" Foreground="{StaticResource TextPrimary}" FontSize="120" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                </StackPanel>
            </Grid>

            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="{StaticResource OverlayBackground}">

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" 
                        Width="580" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <StackPanel>
                        <TextBlock Text="НАСТРОЙКИ ИГРЫ" Foreground="{StaticResource TextHighlight}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <TextBlock Text="БАЗОВЫЕ ПАРАМЕТРЫ" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Ширина поля:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetWidthInput" Grid.Column="1" Text="40" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>

                            <TextBlock Grid.Column="3" Text="Высота поля:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetHeightInput" Grid.Column="4" Text="30" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>

                            <TextBlock Grid.Column="6" Text="Скор. (кл/сек):" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="SetSpeedInput" Grid.Column="7" Text="4" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="НАСТРОЙКИ ЯБЛОК" Foreground="{StaticResource TextSecondary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Макс. на поле" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Эффект роста" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="Задержка (сек)" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="🟩 Обычное" Foreground="{StaticResource FoodNormalColor}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="SetNormCount" Grid.Row="2" Grid.Column="1" Text="3" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                            <TextBox x:Name="SetNormEffect" Grid.Row="2" Grid.Column="3" Text="1" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                            <TextBox x:Name="SetNormDelay" Grid.Row="2" Grid.Column="5" Text="0" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="🟨 Золотое" Foreground="{StaticResource FoodGoldColor}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="SetGoldCount" Grid.Row="4" Grid.Column="1" Text="1" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                            <TextBox x:Name="SetGoldEffect" Grid.Row="4" Grid.Column="3" Text="3" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                            <TextBox x:Name="SetGoldDelay" Grid.Row="4" Grid.Column="5" Text="10" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="🟪 Фиолетовое" Foreground="{StaticResource FoodPurpleColor}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="SetPurpCount" Grid.Row="6" Grid.Column="1" Text="2" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                            <TextBox x:Name="SetPurpEffect" Grid.Row="6" Grid.Column="3" Text="-1" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                            <TextBox x:Name="SetPurpDelay" Grid.Row="6" Grid.Column="5" Text="5" Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="5" TextAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="SettingsErrorText" Foreground="{StaticResource TextError}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Сбросить по умолчанию" Height="40" FontSize="14" Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="ResetSettingsBtn_Click"/>
                            <Button Grid.Column="2" Content="Применить и Закрыть" Height="40" FontSize="14" FontWeight="Bold" Background="{StaticResource ButtonPrimaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="ApplySettingsBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="StatsPanel" Visibility="Collapsed" Background="{StaticResource OverlayBackground}">
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" 
                        Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <StackPanel>

                        <TextBlock x:Name="StatsStatusText" Text="" Foreground="{StaticResource TextInfo}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>

                        <TextBlock Text="ИГРА ОКОНЧЕНА" Foreground="{StaticResource TextHighlight}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="StatsTimerText" Text="Время: 00:00" Foreground="{StaticResource TextSecondary}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock x:Name="StatsP1Name" Text="Игрок 1" Foreground="{StaticResource Snake1Color}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Счет в матче:" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsP1Score" Text="15" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Рекорд:" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsP1Record" Text="25" Foreground="{StaticResource TextSuccess}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                                <StackPanel>
                                    <TextBlock x:Name="StatsP2Name" Text="Игрок 2" Foreground="{StaticResource Snake2Color}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Счет в матче:" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsP2Score" Text="12" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Рекорд:" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatsP2Record" Text="20" Foreground="{StaticResource TextSuccess}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="В лобби" Height="40" FontSize="14" Background="{StaticResource ButtonSecondaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="StatsLobbyBtn_Click"/>
                            <Button x:Name="StatsRematchBtn" Grid.Column="2" Content="Играть снова" Height="40" FontSize="14" FontWeight="Bold" Background="{StaticResource ButtonPrimaryBg}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand" Click="StatsRematchBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>