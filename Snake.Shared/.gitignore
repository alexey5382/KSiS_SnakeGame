## Ignore Visual Studio Temporary Files and Output
=================================================
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono auto generated files
*.pidb

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bbin/
obj/
bin/
Internal/

# Visual Studio 2015/2017/2019/2022 cache directories or files
.vs/
# Generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
CompileOutputs/
_ReSharper*/
*.[Re]Sharper.user

# Tools
_NCrunch_*
.*crunch*.config
AutoTest.Net/

# Enterprise Application patterns
ServerScaffold/

# Executable files
*.exe
*.pdb
*.dll

# JetBrains Rider
.idea/
*.sln.iml

# Windows image caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Package Management
project.lock.json
project.fragment.lock.json
artifacts/

# Paket version control system
.paket/

# Local History for Visual Studio Code
.history/

# Dotenv local environment variables
.env
.env.local
.env.*.local

# Database files (if you generate local test DBs)
*.sqlite
*.dbw